# Local palm captures contain biometric raw/ROI data; keep them off Git remotes.
/code/data
/data
/gitea-um/data
**/pi-captures-*
**/debug_capture/
**/camera_checks/
**/captures/
**/raw_captures/
**/embeddings/
**/*.zip
**/*.7z
**/*.rar
**/*.tgz
**/*.tar
**/*.tar.gz
**/*.npz
**/*.npy
/code/palm_demo/docs/figures/rejection_policy_20261030.png
# Case-level biometric ledgers belong outside the public protocol catalogue.
/code/palm_demo/docs/protocols/*.csv
/code/palm_demo/debug_samples/
.worktrees/

# Local editor, Python caches, and build outputs.
.vscode/
**/__pycache__/
*.py[cod]
*.obj
**/.pytest_cache/

# Old PKLNet assets are local only; do not re-add the retired package.
/code/pklnet/
**/net_params_500.pth
/code/pklnet/pklnet-keypoints.onnx
/code/pklnet/pklnet-keypoints.json
/code/pklnet/pklnet-keypoints-diagnostics.onnx
/code/pklnet/pklnet-keypoints-diagnostics.json

# Biometric captures and generated report images stay local.
code/palm_demo/noir-focus-test*.jpg
docs/_rendered_palm_report/
docs/palm_report_assets/
docs/*.docx

# Local benchmark workspace, dependencies, and extracted datasets.
offline_tongji_roi_audit/
research/
external/

