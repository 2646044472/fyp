[Unit]
Description=Palm Reg camera debug UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fyp
WorkingDirectory=/home/fyp/palm_demo
ExecStart=/home/fyp/palm_demo/.venv/bin/python /home/fyp/palm_demo/debug_ui.py --host 0.0.0.0 --port 8080 --camera 0 --camera-tuning-file /usr/share/libcamera/ipa/rpi/vc4/imx219_noir.json --width 480 --height 360 --capture-only
Restart=on-failure
RestartSec=2
Environment=PYTHONUNBUFFERED=1
Environment=OMP_NUM_THREADS=2
Environment=OPENBLAS_NUM_THREADS=1

[Install]
WantedBy=multi-user.target
