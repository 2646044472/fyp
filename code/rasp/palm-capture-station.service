[Unit]
Description=FYP local palm capture station (PKLNet + FastCC v6)

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
Environment=OMP_NUM_THREADS=2
Environment=OPENBLAS_NUM_THREADS=1
EnvironmentFile=-%h/.config/palm-capture-station.env
ExecStart=%h/palm_demo/.venv/bin/python %h/.local/share/palm-capture-station/capture_station.py
Restart=on-failure
RestartSec=3
UMask=0077

[Install]
WantedBy=default.target
